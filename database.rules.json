{
  "rules": {
    ".read": false,
    ".write": false,
    "events": {
      "$event": {
        ".read": "auth != null && (data.child('type').val() === 'personal' ? data.child('owner').val() === auth.uid : data.child('members').child(auth.uid).exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid && newData.child('members').child(auth.uid).exists() && !newData.child('expenses').exists() && !newData.child('recurring').exists()) || (data.child('owner').val() === auth.uid && ((newData.exists() && newData.child('members').child(auth.uid).exists()) || (!newData.exists() && !data.child('expenses').exists() && !data.child('recurring').exists()))))",
        ".validate": "newData.hasChildren(['owner', 'name', 'currency', 'categories', 'createdAt', 'members']) && (!newData.child('recurring').exists() || newData.child('type').val() === 'personal')",
        "owner": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "currency": {
          ".validate": "newData.val() === 'NZD' || newData.val() === 'USD' || newData.val() === 'EUR' || newData.val() === 'GBP' || newData.val() === 'LKR' || newData.val() === 'AUD'"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "categories": {
          ".validate": "newData.hasChildren()",
          "$category": {
            ".validate": "$category.matches(/^(0|[1-9]|1[0-9])$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && root.child('events').child($event).child('owner').val() === auth.uid && root.child('events').child($event).child('type').val() !== 'personal' && (!data.exists() || !newData.exists()) && $uid !== root.child('events').child($event).child('owner').val()",
            ".validate": "newData.hasChildren(['name']) && (newData.parent().parent().child('type').val() !== 'personal' || $uid === newData.parent().parent().child('owner').val())",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 254"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "expenses": {
          "$expense": {
            ".write": "auth != null && (root.child('events').child($event).child('type').val() === 'personal' ? root.child('events').child($event).child('owner').val() === auth.uid : root.child('events').child($event).child('members').child(auth.uid).exists()) && ((!data.exists() && newData.child('paidBy').val() === auth.uid) || (data.exists() && newData.exists() && data.child('paidBy').val() === auth.uid && newData.child('paidBy').val() === data.child('paidBy').val()) || (!newData.exists() && (data.child('paidBy').val() === auth.uid || root.child('events').child($event).child('owner').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['description', 'amount', 'category', 'date', 'paidBy', 'createdAt'])",
            "description": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120 && (!data.exists() || newData.val() === data.val())"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000 && newData.val() % 1 === 0"
            },
            "category": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && (!data.exists() || newData.val() === data.val())"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
            },
            "paidBy": {
              ".validate": "newData.isString() && (newData.val() === auth.uid || (data.exists() && newData.val() === data.val()))"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val())"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        },
        "type": {
          ".validate": "(newData.val() === 'shared' || newData.val() === 'personal') && (!data.exists() || data.val() === newData.val())"
        },
        "recurring": {
          "$schedule": {
            ".write": "auth != null && root.child('events').child($event).child('owner').val() === auth.uid && root.child('events').child($event).child('type').val() === 'personal' && (!data.exists() || !newData.exists())",
            ".validate": "(newData.hasChildren(['description','amount','category','paidBy','createdAt']) && ((!newData.child('frequency').exists() || newData.child('frequency').val() === 'monthly') ? (newData.hasChildren(['start','end','day']) && newData.child('end').val() >= newData.child('start').val()) : (newData.hasChildren(['startDate','endDate']) && newData.child('endDate').val() >= newData.child('startDate').val()))) && (!data.exists() || (newData.child('description').val() === data.child('description').val() && newData.child('amount').val() === data.child('amount').val() && newData.child('category').val() === data.child('category').val() && newData.child('paidBy').val() === data.child('paidBy').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('start').val() === data.child('start').val() && newData.child('end').val() === data.child('end').val() && newData.child('day').val() === data.child('day').val() && newData.child('frequency').val() === data.child('frequency').val() && newData.child('startDate').val() === data.child('startDate').val() && newData.child('endDate').val() === data.child('endDate').val()))",
            "description": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000 && newData.val() % 1 === 0"
            },
            "category": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "paidBy": {
              ".validate": "newData.isString() && (newData.val() === auth.uid || (data.exists() && newData.val() === data.val()))"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "start": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-(0[1-9]|1[0-2])$/)"
            },
            "end": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-(0[1-9]|1[0-2])$/)"
            },
            "day": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31 && newData.val() % 1 === 0"
            },
            "$other": {
              ".validate": false
            },
            "frequency": {
              ".validate": "newData.val() === 'monthly' || newData.val() === 'weekly' || newData.val() === 'fortnightly'"
            },
            "startDate": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
            },
            "endDate": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
            }
          }
        }
      }
    },
    "userEvents": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$event": {
          ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || (root.child('events').child($event).child('owner').val() === auth.uid && (!newData.exists() || (root.child('events').child($event).child('members').child($uid).exists() && (root.child('events').child($event).child('type').val() !== 'personal' || root.child('events').child($event).child('owner').val() === $uid)))))",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
