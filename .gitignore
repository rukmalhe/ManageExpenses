# Local environment configuration; keep the setup template tracked.
.env
.env.*
!.env.example

# Firebase web configuration generated by scripts/build.mjs.
firebase-config.js

# Installed dependencies and generated deployment files.
node_modules/
dist/

# Firebase emulator state and runtime logs.
.firebase/
*.log

# Test coverage and local test caches.
coverage/
.nyc_output/
.vitest/

# macOS Finder metadata.
.DS_Store
._*
